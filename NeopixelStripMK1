#include <Adafruit_NeoPixel.h>

#define LED_PIN D9
#define LED_COUNT 8

Adafruit_NeoPixel strip(LED_COUNT, LED_PIN, NEO_GRB + NEO_KHZ800);

void showRPM(int leds)
{
  strip.clear();

  for(int i = 0; i < leds; i++)
  {
    if(i < 3)
      strip.setPixelColor(i, strip.Color(0,180,0));      // Soft green
    else if(i < 5)
      strip.setPixelColor(i, strip.Color(180,180,0));    // Soft amber
    else if(i < 7)
      strip.setPixelColor(i, strip.Color(255,80,0));     // Orange
    else
      strip.setPixelColor(i, strip.Color(180,0,0));      // Deep red
  }

  strip.show();
}

void setup()
{
  strip.begin();

  // Premium motorsport brightness
  strip.setBrightness(25);

  strip.show();
}

void loop()
{
  for(int i = 1; i <= LED_COUNT; i++)
  {
    showRPM(i);
    delay(200);
  }

  // Shift flash
  for(int i = 0; i < 3; i++)
  {
    strip.fill(strip.Color(180,0,0));
    strip.show();
    delay(100);

    strip.clear();
    strip.show();
    delay(100);
  }
}
