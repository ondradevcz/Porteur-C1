#include <Wire.h>
#include <Adafruit_MCP23X17.h>
#include <Adafruit_GFX.h>
#include <Adafruit_ST7789.h>
#include <Adafruit_NeoPixel.h>
#include <SPI.h>

#include "USB.h"
#include "USBHIDGamepad.h"

USBHIDGamepad Gamepad;

// ===== DISPLAY =====
#define TFT_CS   D1
#define TFT_DC   D2
#define TFT_RST  D3
#define TFT_MOSI D10
#define TFT_SCLK D8
#define TFT_BL   D0

#define YELLOW 0xFFE0
#define WHITE  ST77XX_WHITE
#define BLACK  ST77XX_BLACK

Adafruit_ST7789 tft = Adafruit_ST7789(TFT_CS, TFT_DC, TFT_MOSI, TFT_SCLK, TFT_RST);

// ===== NEOPIXEL =====
#define LED_PIN   D9
#define LED_COUNT 8
Adafruit_NeoPixel strip(LED_COUNT, LED_PIN, NEO_GRB + NEO_KHZ800);

// ===== MCP23017 =====
Adafruit_MCP23X17 mcp;

#define I2C_SDA D5
#define I2C_SCL D4

#define PADDLE_UP      0
#define PADDLE_DOWN    1
#define BUTTON1        2
#define BUTTON2        3
#define ENC1_A         4
#define ENC1_B         5
#define BUTTON3        6
#define BUTTON4        7
#define ENC2_A         8
#define ENC2_B         9

// ===== STATE =====
String gearText = "N";
String displayedGearText = "";

int speed = 0;
int displayedSpeed = -999;

int rpmPercent = 0;
int displayedRpmPercent = -999;

int displayBrightness = 180;
int ledBrightness = 25;

int lastEnc1A;
int lastEnc2A;

// ===== DISPLAY REFRESH =====
unsigned long lastSpeedDrawTime = 0;
const unsigned long speedDrawIntervalMs = 20; // 50 FPS max

String serialToken = "";

// ===== DECLARATIONS =====
void drawGear(bool force = false);
void drawSpeed(bool force = false);
void showRPMBar(bool force = false);

bool pressed(uint8_t pin) {
  return mcp.digitalRead(pin) == LOW;
}

void setHIDButton(uint8_t buttonNumber, bool pressedNow) {
  if (pressedNow) Gamepad.pressButton(buttonNumber);
  else Gamepad.releaseButton(buttonNumber);
}

void setDisplayBrightness(int value) {
  displayBrightness = constrain(value, 0, 255);
  analogWrite(TFT_BL, 255 - displayBrightness);
}

void setLedBrightness(int value) {
  ledBrightness = constrain(value, 0, 255);
  strip.setBrightness(ledBrightness);
  strip.show();
}

// ===== UI =====
void drawStaticDashboard() {
  tft.fillScreen(BLACK);

  tft.setTextColor(YELLOW);
  tft.setTextSize(1);

  tft.setCursor(8, 8);
  tft.print("PORTEUR C1");

  tft.setCursor(129, 66);
  tft.print("GEAR");

  tft.setCursor(232, 58);
  tft.print("KM/H");

  drawGear(true);
  drawSpeed(true);
}

void drawGear(bool force) {
  if (!force && gearText == displayedGearText) return;

  tft.fillRect(95, 0, 90, 65, BLACK);

  tft.setTextColor(WHITE);
  tft.setTextSize(8);

  int x = 118;
  if (gearText.length() > 1) x = 100;

  tft.setCursor(x, 8);
  tft.print(gearText);

  displayedGearText = gearText;
}

void drawSpeed(bool force) {
  if (!force && speed == displayedSpeed) return;

  tft.fillRect(198, 10, 84, 42, BLACK);

  tft.setTextColor(YELLOW);
  tft.setTextSize(4);

  if (speed < 10) tft.setCursor(245, 15);
  else if (speed < 100) tft.setCursor(225, 15);
  else tft.setCursor(205, 15);

  tft.print(speed);

  displayedSpeed = speed;
}

void showRPMBar(bool force) {
  if (!force && rpmPercent == displayedRpmPercent) return;

  int leds = map(constrain(rpmPercent, 0, 100), 0, 100, 0, LED_COUNT);

  strip.clear();

  for (int i = 0; i < leds; i++) {
    if (i < 3)
      strip.setPixelColor(i, strip.Color(0, 180, 0));
    else if (i < 5)
      strip.setPixelColor(i, strip.Color(180, 180, 0));
    else if (i < 7)
      strip.setPixelColor(i, strip.Color(255, 80, 0));
    else
      strip.setPixelColor(i, strip.Color(180, 0, 0));
  }

  if (rpmPercent >= 95) {
    for (int i = 0; i < LED_COUNT; i++) {
      strip.setPixelColor(i, strip.Color(180, 0, 0));
    }
  }

  strip.show();
  displayedRpmPercent = rpmPercent;
}

// ===== ENCODERS =====
int8_t readEncoder(uint8_t pinA, uint8_t pinB, int &lastA) {
  int8_t delta = 0;

  int currentA = mcp.digitalRead(pinA);
  int currentB = mcp.digitalRead(pinB);

  if (currentA != lastA) {
    if (currentA == LOW) {
      delta = (currentB == HIGH) ? 1 : -1;
    }
    lastA = currentA;
  }

  return delta;
}

// ===== TELEMETRY =====
void processToken(String token) {
  token.trim();
  if (token.length() < 3) return;

  char key = token.charAt(0);
  int eqIndex = token.indexOf('=');
  if (eqIndex < 0) return;

  String value = token.substring(eqIndex + 1);
  value.trim();

  if (key == 'G') {
    gearText = value;
    drawGear();
  } 
  else if (key == 'S') {
    speed = value.toInt();
  } 
  else if (key == 'R') {
    rpmPercent = constrain(value.toInt(), 0, 100);
    showRPMBar();
  }
}

void readSimHubSerialFast() {
  int bytesRead = 0;

  while (Serial.available() && bytesRead < 96) {
    char c = Serial.read();
    bytesRead++;

    if (c == ';') {
      processToken(serialToken);
      serialToken = "";
    } else {
      serialToken += c;
      if (serialToken.length() > 40) serialToken = "";
    }
  }
}

void setup() {
  Serial.begin(115200);

  Gamepad.begin();
  USB.begin();

  delay(1000);

  pinMode(TFT_BL, OUTPUT);
  setDisplayBrightness(displayBrightness);

  tft.init(76, 284);
  tft.setRotation(1);
  tft.invertDisplay(false);

  strip.begin();
  setLedBrightness(ledBrightness);

  Wire.begin(I2C_SDA, I2C_SCL);

  if (!mcp.begin_I2C(0x20)) {
    while (1);
  }

  for (int i = 0; i <= 9; i++) {
    mcp.pinMode(i, INPUT_PULLUP);
  }

  lastEnc1A = mcp.digitalRead(ENC1_A);
  lastEnc2A = mcp.digitalRead(ENC2_A);

  drawStaticDashboard();
  showRPMBar(true);
}

void loop() {
  unsigned long now = millis();

  // ===== INPUTS FIRST =====
  bool paddleUp = pressed(PADDLE_UP);
  bool paddleDown = pressed(PADDLE_DOWN);
  bool btn1 = pressed(BUTTON1);
  bool btn2 = pressed(BUTTON2);
  bool btn3 = pressed(BUTTON3);
  bool btn4 = pressed(BUTTON4);

  setHIDButton(1, paddleUp);
  setHIDButton(2, paddleDown);
  setHIDButton(3, btn1);
  setHIDButton(4, btn2);
  setHIDButton(5, btn3);
  setHIDButton(6, btn4);

  // ===== ENCODERS =====
  int8_t enc1 = readEncoder(ENC1_A, ENC1_B, lastEnc1A);
  int8_t enc2 = readEncoder(ENC2_A, ENC2_B, lastEnc2A);

  if (enc1 != 0) {
    displayBrightness += enc1 * 15;
    displayBrightness = constrain(displayBrightness, 0, 255);
    setDisplayBrightness(displayBrightness);
  }

  if (enc2 != 0) {
    ledBrightness += enc2 * 15;
    ledBrightness = constrain(ledBrightness, 0, 255);
    setLedBrightness(ledBrightness);
    showRPMBar(true);
  }

  // ===== TELEMETRY =====
  readSimHubSerialFast();

  // ===== DISPLAY SPEED =====
  if (now - lastSpeedDrawTime >= speedDrawIntervalMs) {
    drawSpeed();
    lastSpeedDrawTime = now;
  }
}
